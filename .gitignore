node_modules/
dist/
.env
.env.local
*.log
__pycache__/
*.pyc
.claude/

# regenerable raw generator/normaliser output (run generator/generate.py +
# normaliser/normalise.py to recreate) -- the app only needs app/src/data
/data/

# raw ops exports contain employee names / ticket text -- never commit
/Auto Alerts/
/server/cache/

# server/live-data/ holds whatever window the live-mode demo currently serves. If it's
# ever regenerated from the real export (extract_live_incidents.py), that output is
# redacted-but-still-real client ticket text and must stay local -- so the folder is
# gitignored by default. The one exception below is the fully-scrubbed, team-reviewed
# synthetic window, which is safe to commit and is what a fresh checkout ships with.
/server/live-data/*
!/server/live-data/june-window.json

# generated architecture page (regenerate: python scripts/build_architecture_html.py)
/docs/architecture.html

# synthetic (pseudonymised) copies of the demo data: generated locally, copied to the VM out of band
/synthetic-data/

# Local video editing assets, dependencies, and rendered exports
/.video-edit/
/video-output/
